# Production environment template — copy to .env on the VPS.
# cp .env.production.example .env
# Edit all CHANGE_ME values before going live. Never commit .env.

# --- Application ---
APP_ENV=production
APP_NAME=Service Platform API
API_V1_PREFIX=/api/v1
API_DOCS_ENABLED=false

# --- Database (must match postgres service in docker-compose.prod.yml) ---
POSTGRES_USER=service_platform
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=service_platform
DATABASE_URL=postgresql+asyncpg://service_platform:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/service_platform

# --- Compose (optional) ---
# Host port for web container HTTP (default 80). Use 8080 locally if port 80 is taken.
WEB_HTTP_PORT=80

# --- Auth (generate a long random string, e.g. openssl rand -hex 32) ---
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS (comma-separated; include your public site URL with https) ---
CORS_ORIGINS=https://your-domain.example

# --- Public URLs (for runbooks / reverse proxy config; not all are read by the app today) ---
PUBLIC_APP_URL=https://your-domain.example
PUBLIC_API_URL=https://your-domain.example/api/v1

# --- Timezone (container / ops; set TZ on host or in compose if needed) ---
TZ=UTC

# --- Future integrations (leave empty until implemented) ---
STRIPE_SECRET_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
