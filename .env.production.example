# Production environment template — copy to .env on the VPS.
# cp .env.production.example .env
# Edit all CHANGE_ME values before going live. Never commit .env.

# --- Application ---
APP_ENV=production
APP_NAME=Service Platform API
API_V1_PREFIX=/api/v1
API_DOCS_ENABLED=false

# --- Database (must match postgres service in docker-compose.prod.yml) ---
POSTGRES_USER=service_platform
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=service_platform
DATABASE_URL=postgresql+asyncpg://service_platform:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/service_platform

# --- Compose (optional) ---
# Host port for web container HTTP (default 80). Use 8080 locally if port 80 is taken.
WEB_HTTP_PORT=80

# --- Auth (generate a long random string, e.g. openssl rand -hex 32) ---
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS (comma-separated; include your public site URL with https) ---
CORS_ORIGINS=https://your-domain.example

# --- Public URLs (for runbooks / reverse proxy config; not all are read by the app today) ---
PUBLIC_APP_URL=https://your-domain.example
PUBLIC_API_URL=https://your-domain.example/api/v1

# --- Timezone (container / ops; set TZ on host or in compose if needed) ---
TZ=UTC

# --- Stripe platform billing (disabled until checkout/webhook slices) ---
# Set STRIPE_ENABLED=true only after price IDs and secrets are configured on the VPS.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=https://your-domain.example/billing/success
STRIPE_CANCEL_URL=https://your-domain.example/billing/cancel

# --- Email (disabled/dry-run by default — configure real SMTP manually on VPS) ---
EMAIL_ENABLED=false
EMAIL_DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Service Platform
SMTP_USE_TLS=true

# --- Email verification (set base URL to your public frontend verify route) ---
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
EMAIL_VERIFICATION_BASE_URL=https://your-domain.example/verify-email
REQUIRE_EMAIL_VERIFICATION_FOR_LOGIN=false

PASSWORD_RESET_TOKEN_EXPIRE_HOURS=2
PASSWORD_RESET_BASE_URL=https://your-domain.example/reset-password
