# Production environment template — copy to .env on the VPS only.
#   cp .env.production.example .env
# Edit all CHANGE_ME values on the server. Never commit .env or .env.production.
# Run before go-live: python scripts/check_production_env.py --env-file .env --strict
# Email readiness (no real send): docker compose exec api python scripts/check_email_readiness.py
# Template sanity (expected to fail strict — placeholders are intentional):
#   python scripts/check_production_env.py --env-file .env.production.example
#   python scripts/check_production_env.py --env-file .env.production.example --strict
#
# Demo seed safety: do NOT run `python scripts/seed_demo.py` when APP_ENV=production.
# Do NOT set ALLOW_DEMO_SEED_IN_PRODUCTION or DEMO_PASSWORD on public production.

# =============================================================================
# Core application
# =============================================================================
APP_ENV=production
APP_NAME=Service Platform API
API_V1_PREFIX=/api/v1
# Keep false in production — OpenAPI UI must not be public.
API_DOCS_ENABLED=false
# Keep false — avoids logging sensitive SQL bind parameters in echo.
SQLALCHEMY_ECHO=false

# =============================================================================
# Database (must match postgres service in docker-compose.prod.yml)
# =============================================================================
POSTGRES_USER=service_platform
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=service_platform
DATABASE_URL=postgresql+asyncpg://service_platform:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/service_platform

# =============================================================================
# Compose / networking
# =============================================================================
# Host port mapped to web container nginx (internal 8080). Use 8080 for local prod smoke.
WEB_HTTP_PORT=80
# Comma-separated HTTPS origins only — no wildcard * in production.
CORS_ORIGINS=https://your-domain.example

# Ops / reverse-proxy reference (not all read by the app today).
PUBLIC_APP_URL=https://your-domain.example
PUBLIC_API_URL=https://your-domain.example/api/v1
TZ=UTC

# =============================================================================
# Auth (generate on server, e.g. openssl rand -hex 32)
# =============================================================================
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# Email (disabled + dry-run by default — configure real SMTP on VPS when ready)
# =============================================================================
# EMAIL_ENABLED=false — no outbound email until SMTP is configured.
# EMAIL_DRY_RUN=true  — log/dry-run only; set false only after SMTP is verified on VPS.
# check_email_readiness.py validates mode safely without sending (see README_BACKEND.md).
EMAIL_ENABLED=false
EMAIL_DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
# Env name is SMTP_USER (not SMTP_USERNAME).
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Service Platform
SMTP_USE_TLS=true

# Public frontend routes for verification and password reset (HTTPS, not localhost).
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
EMAIL_VERIFICATION_BASE_URL=https://your-domain.example/verify-email
REQUIRE_EMAIL_VERIFICATION_FOR_LOGIN=false
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=2
PASSWORD_RESET_BASE_URL=https://your-domain.example/reset-password

# =============================================================================
# Stripe platform billing (disabled until checkout/webhook ready on VPS)
# =============================================================================
# Env names: STRIPE_PRICE_STARTER / BUSINESS / PRO (Stripe Price IDs from dashboard).
# Set STRIPE_ENABLED=true only after secrets and price IDs are on the server.
STRIPE_ENABLED=false
# When enabling: use real keys on VPS only. Examples below are obviously fake placeholders:
# STRIPE_SECRET_KEY=sk_test_REDACTED
# STRIPE_WEBHOOK_SECRET=whsec_REDACTED
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=https://your-domain.example/billing/success
STRIPE_CANCEL_URL=https://your-domain.example/billing/cancel
