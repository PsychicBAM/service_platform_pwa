# Copy to .env.local for local Vite dev (do not commit .env or .env.local)
#
# Option A — direct API (default):
VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# Option B — Vite dev proxy (same-origin, avoids CORS):
# VITE_API_BASE_URL=/api/v1
#
# Docker production (web container) uses /api/v1 via nginx → api:8000.
# Set at build time in web/Dockerfile; no .env file needed in the image.
