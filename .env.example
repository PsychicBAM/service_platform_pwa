# Copy to .env for local Docker / development. Do not commit .env.

APP_ENV=local
APP_NAME=Service Platform API
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://service_platform:service_platform@postgres:5432/service_platform

JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenAPI /docs — enabled for local dev (auto-enabled when APP_ENV=local|dev)
API_DOCS_ENABLED=true

# --- Email (disabled/dry-run by default — no real SMTP in local dev) ---
EMAIL_ENABLED=false
EMAIL_DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Service Platform
SMTP_USE_TLS=true
